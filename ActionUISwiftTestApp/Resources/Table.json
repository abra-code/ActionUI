{
  "type": "VStack",
  "properties": {
    "spacing": 8,
    "padding": "default",
    "frame": { "maxWidth": 600, "maxHeight": 500 }
  },
  "children": [
    {
      "type": "HStack",
      "properties": { "spacing": 12, "padding": "default" },
      "children": [
        {
          "type": "Button",
          "properties": {
            "title": "Load Data",
            "actionID": "table.demo.load",
            "buttonStyle": "bordered"
          }
        },
        {
          "type": "Button",
          "properties": {
            "title": "Append Row",
            "actionID": "table.demo.append",
            "buttonStyle": "bordered"
          }
        },
        {
          "type": "Button",
          "properties": {
            "title": "Clear",
            "actionID": "table.demo.clear",
            "buttonStyle": "bordered"
          }
        }
      ]
    },
    {
      "type": "HStack",
      "properties": { "spacing": 12, "padding": { "leading": 16, "trailing": 16 } },
      "children": [
        {
          "type": "Button",
          "properties": {
            "title": "Select Row #3",
            "actionID": "table.demo.select.index",
            "buttonStyle": "bordered"
          }
