        "actionID": "table.demo.selection.changed"
      }
    },
    {
      "type": "Text",
      "id": 2,
      "properties": {
        "text": "Selected: (none)",
        "padding": { "leading": 16, "trailing": 16, "bottom": 8 }
      }
    }
  ]
