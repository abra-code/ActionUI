{
  "type": "ScrollView",
  "content": {
  "type": "VStack",
  "properties": { "padding": "default", "spacing": 16 },
  "children": [
    { "type": "Text", "properties": { "text": "Weekly users by platform (inline data, smoothed lines and a goal rule)", "font": "headline" } },
    {
      "type": "Chart",
      "id": 11,
      "properties": {
        "frame": { "minHeight": 240 },
        "chart": {
          "columns": [{ "name": "week", "type": "date" }, "platform", { "name": "users", "type": "number" }],
          "data": [
            ["2026-08-03", "iOS", 1180], ["2026-08-03", "macOS", 790],
            ["2026-08-10", "iOS", 1240], ["2026-08-10", "macOS", 805],
            ["2026-08-17", "iOS", 1310], ["2026-08-17", "macOS", 860],
            ["2026-08-24", "iOS", 1290], ["2026-08-24", "macOS", 910]
          ],
          "content": [
            { "type": "ForEach", "content": [
              { "type": "LineMark",
                "x": { "label": "Week", "value": "$week", "unit": "weekOfYear" },
                "y": { "label": "Users", "value": "$users" },
                "foregroundStyle": { "by": { "label": "Platform", "value": "$platform" } },
                "interpolationMethod": "catmullRom" }
            ] },
            { "type": "RuleMark", "y": { "label": "Goal", "value": 1250 },
              "lineStyle": { "lineWidth": 1, "dash": [4, 3] }, "foregroundStyle": "gray" }
          ],
          "chartYScale": { "domain": [0, 1500] },
          "chartXAxisLabel": "Week",
          "chartYAxisLabel": "Users",
          "chartLegend": { "position": "bottom" }
        }
      }
    },
    { "type": "Text", "properties": { "text": "Tickets by month (integer column, stacked bars)", "font": "headline" } },
    {
      "type": "Chart",
      "id": 12,
      "properties": {
        "frame": { "minHeight": 200 },
        "chart": {
          "columns": ["month", "team", { "name": "tickets", "type": "integer" }],
          "data": [
            ["Jan", "Apps", 3], ["Jan", "Web", 1], ["Feb", "Apps", 2], ["Feb", "Web", 2],
            ["Mar", "Apps", 4], ["Mar", "Web", 1]
          ],
          "content": [
            { "type": "ForEach", "content": [
              { "type": "BarMark",
                "x": { "label": "Month", "value": "$month" },
                "y": { "label": "Tickets", "value": "$tickets" },
                "foregroundStyle": { "by": { "label": "Team", "value": "$team" } } }
            ] }
          ]
        }
      }
    },
    { "type": "Text", "properties": { "text": "Daily temperature range (range bars, point marks for the average)", "font": "headline" } },
    {
      "type": "Chart",
      "id": 13,
      "properties": {
        "frame": { "minHeight": 200 },
        "chart": {
          "columns": ["day", { "name": "low", "type": "number" }, { "name": "high", "type": "number" }, { "name": "mean", "type": "number" }],
          "data": [["Mon", 11, 19, 15], ["Tue", 12, 22, 17], ["Wed", 9, 16, 12.5], ["Thu", 13, 24, 18.5], ["Fri", 14, 21, 17.5]],
          "content": [
            { "type": "ForEach", "content": [
              { "type": "BarMark",
                "x": { "label": "Day", "value": "$day" },
                "yStart": { "label": "Low", "value": "$low" },
                "yEnd": { "label": "High", "value": "$high" },
                "width": { "ratio": 0.35 }, "cornerRadius": 4, "foregroundStyle": "orange.opacity(0.5)",
                "accessibilityLabel": "$day", "accessibilityValue": "$low to $high degrees" },
              { "type": "PointMark",
                "x": { "label": "Day", "value": "$day" },
                "y": { "label": "Average", "value": "$mean" },
                "symbol": "diamond", "symbolSize": 60, "foregroundStyle": "red" }
            ] }
          ],
          "chartYAxisLabel": { "text": "Degrees", "position": "leading" },
          "chartPlotStyle": { "background": "gray.opacity(0.08)" }
        }
      }
    }
  ]
  }
}
