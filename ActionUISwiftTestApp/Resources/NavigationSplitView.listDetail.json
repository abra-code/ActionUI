{
  "type": "NavigationSplitView",
  "id": 1,
  "properties": {
    "columnVisibility": "all",
    "style": "balanced",
    "frame": {
      "minWidth": 800,
      "minHeight": 540
    },
    "padding": {
      "top": 4
    }
  },
  "sidebar": {
    "type": "VStack",
    "properties": {
      "spacing": 8,
      "navigationSplitViewColumnWidth": {
        "min": 220,
        "ideal": 320,
        "max": 360
      }
    },
    "children": [
      {
        "type": "Table",
        "id": 10,
        "properties": {
          "columns": [
            "Document"
          ],
          "widths": [
            280
          ],
          "minWidths": [
            120
          ],
          "scrollContentBackground": "hidden",
          "actionID": "listdetail.selection.changed"
        }
      },
      {
        "type": "HStack",
        "properties": {
          "spacing": 0
        },
        "children": [
          {
            "type": "Button",
            "id": 11,
            "properties": {
              "systemImage": "plus.circle",
              "imageScale": "large",
              "buttonStyle": "plain",
