              { "type": "LabeledContent", "properties": { "title": "Storage" }, "children": [ { "type": "Text", "properties": { "text": "~/Documents/Projects" } } ] },
              { "type": "LabeledContent", "properties": { "title": "Free disk space" }, "children": [ { "type": "Text", "properties": { "text": "71 GB" } } ] }
