                    { "type": "Button", "id": 117, "properties": { "title": "Resume", "buttonStyle": "borderedProminent", "actionID": "nsv.template.projects.pauseresume" } },
                    { "type": "Button", "properties": { "title": "Open", "actionID": "nsv.template.projects.open" } },
                    { "type": "Spacer" },
                    { "type": "Button", "properties": { "title": "Delete...", "role": "destructive", "actionID": "nsv.template.projects.delete" } }
