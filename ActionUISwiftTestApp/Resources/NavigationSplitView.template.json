              { "type": "Text", "properties": { "text": "$1", "font": { "size": 17, "weight": "bold" } } },
              { "type": "Text", "properties": { "text": "$3", "font": "caption", "opacity": 0.85 } }
            ]
          },
          "toolbar": [
