                "properties": { "systemImage": "plus", "help": "New Project...", "actionID": "nsv.template.projects.new" }
              }
            }
          ]
        },
        "detail": {
          "type": "ZStack",
          "properties": { "frame": { "maxWidth": "infinity", "maxHeight": "infinity" } },
