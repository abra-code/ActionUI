{
  "type": "TabView",
  "id": 1,
  "properties": {
    "frame": { "minWidth": 760, "minHeight": 480, "idealWidth": 900, "idealHeight": 560 }
  },
  "children": [
    {
      "type": "Tab",
      "properties": { "title": "Projects", "systemImage": "folder" },
      "content": {
        "type": "NavigationSplitView",
        "id": 100,
        "properties": {
          "columnVisibility": "all",
          "style": "balanced",
          "onAppearActionID": "nsv.template.projects.load"
        },
        "sidebar": {
          "type": "List",
          "id": 101,
          "properties": {
            "actionID": "nsv.template.projects.selected",
            "listStyle": "sidebar",
            "listRowSeparator": "hidden",
            "listRowInsets": { "top": 4, "leading": 8, "bottom": 4, "trailing": 8 },
            "navigationSplitViewColumnWidth": { "min": 220, "ideal": 260, "max": 340 }
          },
          "template": {
            "type": "VStack",
            "properties": {
              "alignment": "leading",
              "spacing": 6,
              "padding": 12,
              "frame": { "maxWidth": "infinity", "alignment": "leading" },
              "foregroundStyle": "white",
              "background": "$5",
              "cornerRadius": 12
            },
            "children": [
              {
                "type": "HStack",
                "children": [
                  { "type": "Image", "properties": { "systemName": "$2", "font": "title2" } },
                  { "type": "Spacer" },
                  { "type": "Image", "properties": { "systemName": "$4", "font": "title2" } }
