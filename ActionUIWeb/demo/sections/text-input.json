{
  "type": "VStack",
  "properties": { "alignment": "leading", "spacing": 12 },
  "children": [
    { "type": "Text", "properties": { "text": "Text Input", "font": "title2" } },
    { "type": "Text", "properties": { "text": "TextField with a submit action; type a name and press Return or Greet (the status line at the bottom of the window echoes the result):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 8 },
      "children": [
        { "type": "TextField", "id": 1, "properties": { "title": "Name", "prompt": "Enter your name", "actionID": "greet", "frame": { "maxWidth": "infinity" } } },
        { "type": "Button", "id": 2, "properties": { "title": "Greet", "systemImage": "hand.wave", "buttonStyle": "borderedProminent", "actionID": "greet" } }
      ]
    },
    { "type": "Toggle", "id": 3, "properties": { "title": "Shout the greeting", "actionID": "shoutChanged" } },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "SecureField (masked entry):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 8 },
      "children": [
        { "type": "SecureField", "id": 50, "properties": { "title": "Password", "prompt": "Enter password", "textContentType": "password", "actionID": "passwordSubmit", "frame": { "maxWidth": "infinity" } } },
        { "type": "Button", "id": 51, "properties": { "title": "Sign in", "systemImage": "lock.fill", "buttonStyle": "borderedProminent", "actionID": "passwordSubmit" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "TextEditor (multi-line, scrolls internally):", "foregroundStyle": "secondary", "font": "callout" } },
    { "type": "TextEditor", "id": 95, "properties": { "placeholder": "Meeting notes…", "valueChangeActionID": "notesChanged", "frame": { "maxWidth": "infinity", "height": 90 } } }
  ]
}
