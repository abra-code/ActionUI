{
  "type": "VStack",
  "properties": { "alignment": "leading", "spacing": 12 },
  "children": [
    { "type": "Text", "properties": { "text": "Shapes & Layout", "font": "title2" } },
    { "type": "Text", "properties": { "text": "Shapes (fill, stroke, bare):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12 },
      "children": [
        { "type": "Rectangle", "properties": { "fill": "blue", "frame": { "width": 56, "height": 36 } } },
        { "type": "RoundedRectangle", "properties": { "cornerRadius": 10, "fill": "teal", "frame": { "width": 56, "height": 36 } } },
        { "type": "RoundedRectangle", "properties": { "cornerRadius": 10, "cornerStyle": "continuous", "stroke": "purple", "strokeLineWidth": 2, "frame": { "width": 56, "height": 36 } } },
        { "type": "Capsule", "properties": { "fill": "accentColor", "frame": { "width": 64, "height": 24 } } },
        { "type": "Circle", "properties": { "stroke": "red", "strokeLineWidth": 3, "frame": { "width": 36, "height": 36 } } },
        { "type": "Ellipse", "properties": { "fill": "orange", "frame": { "width": 56, "height": 32 } } }
      ]
    },
    { "type": "Text", "properties": { "text": "Color as a View (a greedy solid-color block - named, hex, or color.opacity; sized via frame):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12, "alignment": "center" },
      "children": [
        { "type": "Color", "properties": { "color": "blue", "frame": { "width": 56, "height": 36 }, "cornerRadius": 8 } },
        { "type": "Color", "properties": { "color": "#34C759", "frame": { "width": 56, "height": 36 }, "cornerRadius": 8 } },
        {
          "type": "ZStack",
          "properties": { "frame": { "width": 96, "height": 36 } },
          "children": [
            { "type": "Text", "properties": { "text": "tinted", "font": "caption" } },
            { "type": "Color", "properties": { "color": "yellow.opacity(0.4)", "cornerRadius": 8 } }
          ]
        }
      ]
    },
    { "type": "Text", "properties": { "text": "A Color as a thin colored bar (240 x 2):", "foregroundStyle": "secondary", "font": "callout" } },
    { "type": "Color", "properties": { "color": "red", "frame": { "width": 240, "height": 2 } } },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "safeAreaInset (a bar pinned at an edge; the content takes the rest). Below is the layout in a bounded box; the real screen-edge clearance (under the home indicator) needs the page to fill the viewport - open the fullscreen demo and hide Safari's toolbar:", "foregroundStyle": "secondary", "font": "callout" } },
    { "type": "Link", "properties": { "title": "Open the fullscreen SafeArea demo", "url": "safe-area.html" } },
    {
      "type": "ScrollView",
      "properties": { "frame": { "maxWidth": "infinity", "minHeight": 140, "maxHeight": 140 }, "background": "#f2f2f7", "cornerRadius": 10 },
      "content": {
        "type": "VStack",
        "properties": { "spacing": 8, "alignment": "leading", "padding": 12 },
        "children": [
          { "type": "Text", "properties": { "text": "Scroll me - the blue bar never covers this." } },
          { "type": "Text", "properties": { "text": "Line 2" } },
          { "type": "Text", "properties": { "text": "Line 3" } },
          { "type": "Text", "properties": { "text": "Line 4" } },
          { "type": "Text", "properties": { "text": "Line 5" } },
          { "type": "Text", "properties": { "text": "Last line" } }
        ]
      },
      "safeAreaInset": {
        "type": "HStack",
        "properties": { "safeAreaEdge": "bottom", "padding": 10, "background": "accentColor" },
        "children": [ { "type": "Text", "properties": { "text": "Bottom bar (safeAreaInset)", "foregroundStyle": "white" } } ]
      }
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Frame alignment (content placed within a larger frame):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12 },
      "children": [
        { "type": "Text", "properties": { "text": "TL", "background": "#e3f0ff", "cornerRadius": 6, "frame": { "width": 84, "height": 56, "alignment": "topLeading" } } },
        { "type": "Text", "properties": { "text": "top", "background": "#e3f0ff", "cornerRadius": 6, "frame": { "width": 84, "height": 56, "alignment": "top" } } },
        { "type": "Text", "properties": { "text": "C", "background": "#e3f0ff", "cornerRadius": 6, "frame": { "width": 84, "height": 56, "alignment": "center" } } },
        { "type": "Text", "properties": { "text": "BT", "background": "#e3f0ff", "cornerRadius": 6, "frame": { "width": 84, "height": 56, "alignment": "bottomTrailing" } } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "hidden (SwiftUI .hidden(): invisible, untouchable and silent to screen readers - but STILL LAID OUT. The middle square below is hidden, and the gap it leaves behind is the point: hidden reserves its space on all three hosts. There is no collapse semantic; to swap views, overlay them in a ZStack and hide all but one):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12 },
      "children": [
        { "type": "Rectangle", "properties": { "fill": "#EF9A9A", "frame": { "width": 48, "height": 32 } } },
        { "type": "Rectangle", "properties": { "fill": "#EF9A9A", "frame": { "width": 48, "height": 32 }, "hidden": true } },
        { "type": "Rectangle", "properties": { "fill": "#EF9A9A", "frame": { "width": 48, "height": 32 } } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Overlay / background (view-valued decorations):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 16, "alignment": "center" },
      "children": [
        {
          "type": "Text",
          "properties": { "text": "Background view", "padding": 12, "foregroundStyle": "white", "cornerRadius": 10 },
          "background": { "type": "RoundedRectangle", "properties": { "cornerRadius": 10, "fill": "indigo" } }
        },
        {
          "type": "Image",
          "properties": { "systemName": "bell.fill", "imageScale": "large", "foregroundStyle": "secondary", "frame": { "width": 44, "height": 44 }, "overlayAlignment": "topTrailing" },
          "overlay": { "type": "Text", "properties": { "text": "3", "foregroundStyle": "white", "background": "red", "cornerRadius": 8, "padding": { "top": 1, "bottom": 1, "leading": 6, "trailing": 6 }, "font": "caption2" } }
        },
        {
          "type": "Text",
          "properties": { "text": "Both", "padding": 14, "foregroundStyle": "white", "overlayAlignment": "bottomTrailing" },
          "background": { "type": "Capsule", "properties": { "fill": "teal" } },
          "overlay": { "type": "Image", "properties": { "systemName": "checkmark.circle.fill", "foregroundStyle": "white" } }
        }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Grid (explicit rows, key/value):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "Grid",
      "properties": { "alignment": "leading", "horizontalSpacing": 16, "verticalSpacing": 6 },
      "rows": [
        [
          { "type": "Text", "properties": { "text": "Name", "foregroundStyle": "secondary" } },
          { "type": "Text", "properties": { "text": "ActionUIWeb" } }
        ],
        [
          { "type": "Text", "properties": { "text": "Renderer", "foregroundStyle": "secondary" } },
          { "type": "Text", "properties": { "text": "DOM + CSS" } }
        ],
        [
          { "type": "Text", "properties": { "text": "Loaded from", "foregroundStyle": "secondary" } },
          { "type": "Label", "properties": { "title": "shapes-layout.json", "systemImage": "text.document" } }
        ]
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Group is a transparent passthrough - its children flow into the parent HStack as if it were not there:", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 8 },
      "children": [
        { "type": "Text", "properties": { "text": "Before" } },
        {
          "type": "Group",
          "children": [
            { "type": "Image", "properties": { "systemName": "1.circle", "imageScale": "large", "foregroundStyle": "accentColor" } },
            { "type": "Image", "properties": { "systemName": "2.circle", "imageScale": "large", "foregroundStyle": "accentColor" } },
            { "type": "Image", "properties": { "systemName": "3.circle", "imageScale": "large", "foregroundStyle": "accentColor" } }
          ]
        },
        { "type": "Text", "properties": { "text": "After" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "GeometryReader (a greedy box that fills its frame and reports its measured size to the host as states[\"size\"] - read it on demand, the same call on every platform). It fills the width; its height is a fixed 90 (the bounded-axis caveat: inside a vertical scroll there is no height to fill). Resize the window, then read the size:", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "GeometryReader",
      "id": 410,
      "properties": { "alignment": "center", "background": "secondary", "cornerRadius": 12, "frame": { "maxWidth": "infinity", "minHeight": 90, "maxHeight": 90 } },
      "content": {
        "type": "VStack",
        "properties": { "alignment": "center", "spacing": 8 },
        "children": [
          { "type": "Text", "properties": { "text": "I am a GeometryReader. My content sits at alignment 'center'.", "font": "footnote", "foregroundStyle": "secondary" } },
          { "type": "Button", "properties": { "title": "Read my size", "systemImage": "ruler", "buttonStyle": "bordered", "actionID": "readGeometrySize" } }
        ]
      }
    }
  ]
}
