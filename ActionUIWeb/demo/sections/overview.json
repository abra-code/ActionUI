{
  "type": "VStack",
  "properties": { "alignment": "leading", "spacing": 12 },
  "children": [
    { "type": "Text", "properties": { "text": "Overview", "font": "title2" } },
    { "type": "Text", "properties": { "text": "This whole page is a NavigationSplitView; each sidebar section is a separate JSON file loaded on demand by a LoadableView.", "foregroundColor": "secondary" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12 },
      "children": [
        { "type": "Image", "properties": { "systemName": "heart.fill", "imageScale": "large", "foregroundColor": "red" } },
        { "type": "Image", "properties": { "systemName": "gearshape", "imageScale": "large", "foregroundColor": "secondary" } },
        { "type": "Image", "properties": { "systemName": "trash", "imageScale": "large", "foregroundColor": "secondary" } },
        { "type": "Image", "properties": { "materialName": "rocket_launch", "imageScale": "large", "foregroundColor": "accentColor" } }
      ]
    },
    {
      "type": "HStack",
      "properties": { "spacing": 16 },
      "children": [
        { "type": "Label", "properties": { "title": "Favorites", "systemImage": "star.fill", "foregroundColor": "yellow" } },
        { "type": "Label", "properties": { "title": "Trash", "systemImage": "trash", "foregroundColor": "secondary" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Symbols & diagnostics:", "foregroundColor": "secondary", "font": "callout" } },
    { "type": "Text", "properties": { "text": "ActionUI maps SF Symbols to the closest Material Symbol. A name with no mapping renders nothing and logs a warning in the Diagnostics panel below. Turn on 'Debug glyphs' (then reload) to draw a broken-image placeholder in its place. Use 'materialName' for an explicit Material glyph.", "foregroundColor": "secondary" } },
    {
      "type": "VStack",
      "properties": { "alignment": "leading", "spacing": 6 },
      "children": [
        { "type": "Label", "properties": { "title": "Unmapped: systemImage \"example.unmapped.symbol\"", "systemImage": "example.unmapped.symbol" } },
        { "type": "Label", "properties": { "title": "Explicit Material glyph: materialName \"description\"", "materialName": "description" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Shapes (fill, stroke, bare):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12 },
      "children": [
        { "type": "Rectangle", "properties": { "fill": "blue", "frame": { "width": 56, "height": 36 } } },
        { "type": "RoundedRectangle", "properties": { "cornerRadius": 10, "fill": "teal", "frame": { "width": 56, "height": 36 } } },
        { "type": "RoundedRectangle", "properties": { "cornerRadius": 10, "cornerStyle": "continuous", "stroke": "purple", "strokeLineWidth": 2, "frame": { "width": 56, "height": 36 } } },
        { "type": "Capsule", "properties": { "fill": "accentColor", "frame": { "width": 64, "height": 24 } } },
        { "type": "Circle", "properties": { "stroke": "red", "strokeLineWidth": 3, "frame": { "width": 36, "height": 36 } } },
        { "type": "Ellipse", "properties": { "fill": "orange", "frame": { "width": 56, "height": 32 } } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Grid (explicit rows, key/value):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "Grid",
      "properties": { "alignment": "leading", "horizontalSpacing": 16, "verticalSpacing": 6 },
      "rows": [
        [
          { "type": "Text", "properties": { "text": "Name", "foregroundColor": "secondary" } },
          { "type": "Text", "properties": { "text": "ActionUIWeb" } }
        ],
        [
          { "type": "Text", "properties": { "text": "Renderer", "foregroundColor": "secondary" } },
          { "type": "Text", "properties": { "text": "DOM + CSS" } }
        ],
        [
          { "type": "Text", "properties": { "text": "Loaded from", "foregroundColor": "secondary" } },
          { "type": "Label", "properties": { "title": "overview.json", "systemImage": "text.document" } }
        ]
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Scroll horizontally:", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "ScrollView",
      "properties": { "axis": "horizontal", "showsIndicators": false, "frame": { "maxWidth": "infinity" } },
      "content": {
        "type": "LazyHStack",
        "properties": { "spacing": 8 },
        "children": [
          { "type": "Button", "properties": { "title": "Inbox", "systemImage": "tray", "buttonStyle": "bordered" } },
          { "type": "Button", "properties": { "title": "Sent", "systemImage": "paperplane", "buttonStyle": "bordered" } },
          { "type": "Button", "properties": { "title": "Drafts", "systemImage": "text.document", "buttonStyle": "bordered" } },
          { "type": "Button", "properties": { "title": "Archive", "systemImage": "archivebox", "buttonStyle": "bordered" } },
          { "type": "Button", "properties": { "title": "Flagged", "systemImage": "flag", "buttonStyle": "bordered" } },
          { "type": "Button", "properties": { "title": "Trash", "systemImage": "trash", "buttonStyle": "bordered" } }
        ]
      }
    },
    { "type": "Text", "properties": { "text": "LazyVGrid (three flexible columns):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "LazyVGrid",
      "properties": {
        "columns": [{ "flexible": true }, { "flexible": true }, { "flexible": true }],
        "spacing": 8,
        "frame": { "maxWidth": "infinity" }
      },
      "children": [
        { "type": "Button", "properties": { "title": "7", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "8", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "9", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "4", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "5", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "6", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "1", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "2", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "3", "buttonStyle": "bordered" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "ScrollViewReader (opens centered on Row 6; buttons scroll programmatically):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 8 },
      "children": [
        { "type": "Button", "properties": { "title": "Top", "systemImage": "arrow.up.to.line", "buttonStyle": "bordered", "actionID": "svrTop" } },
        { "type": "Button", "properties": { "title": "Middle", "systemImage": "arrow.up.and.down", "buttonStyle": "bordered", "actionID": "svrMiddle" } },
        { "type": "Button", "properties": { "title": "Bottom", "systemImage": "arrow.down.to.line", "buttonStyle": "bordered", "actionID": "svrBottom" } }
      ]
    },
    {
      "type": "ScrollViewReader",
      "id": 140,
      "properties": { "scrollTo": 146, "anchor": "center" },
      "content": {
        "type": "ScrollView",
        "properties": { "axis": "vertical", "frame": { "height": 150, "maxWidth": "infinity" } },
        "content": {
          "type": "VStack",
          "properties": { "alignment": "leading", "spacing": 6 },
          "children": [
            { "type": "Text", "id": 141, "properties": { "text": "Row 1" } },
            { "type": "Text", "id": 142, "properties": { "text": "Row 2" } },
            { "type": "Text", "id": 143, "properties": { "text": "Row 3" } },
            { "type": "Text", "id": 144, "properties": { "text": "Row 4" } },
            { "type": "Text", "id": 145, "properties": { "text": "Row 5" } },
            { "type": "Text", "id": 146, "properties": { "text": "Row 6", "font": "headline", "foregroundColor": "accentColor" } },
            { "type": "Text", "id": 147, "properties": { "text": "Row 7" } },
            { "type": "Text", "id": 148, "properties": { "text": "Row 8" } },
            { "type": "Text", "id": 149, "properties": { "text": "Row 9" } },
            { "type": "Text", "id": 150, "properties": { "text": "Row 10" } },
            { "type": "Text", "id": 151, "properties": { "text": "Row 11" } },
            { "type": "Text", "id": 152, "properties": { "text": "Row 12" } }
          ]
        }
      }
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "AsyncImage (a browser <img>; an SF Symbol placeholder shows while loading and on failure):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12, "alignment": "top" },
      "children": [
        {
          "type": "VStack",
          "properties": { "alignment": "leading", "spacing": 4 },
          "children": [
            { "type": "AsyncImage", "properties": { "url": "https://abracode.com/ActionUI/abracadabra.png", "cornerRadius": 8, "frame": { "width": 240, "height": 150 } } },
            { "type": "Text", "properties": { "text": "Loaded from a URL", "foregroundColor": "secondary", "font": "footnote" } }
          ]
        },
        {
          "type": "VStack",
          "properties": { "alignment": "leading", "spacing": 4 },
          "children": [
            { "type": "AsyncImage", "properties": { "url": "https://example.invalid/missing.png", "placeholder": "exclamationmark.triangle", "frame": { "width": 120, "height": 150 } } },
            { "type": "Text", "properties": { "text": "Broken URL -> placeholder", "foregroundColor": "secondary", "font": "footnote" } }
          ]
        }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "VideoPlayer (a native <video> with transport controls; bound its height with a frame):", "foregroundColor": "secondary", "font": "callout" } },
