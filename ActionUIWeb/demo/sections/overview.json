{
  "type": "VStack",
  "properties": { "alignment": "leading", "spacing": 12 },
  "children": [
    { "type": "Text", "properties": { "text": "Overview", "font": "title2" } },
    { "type": "Text", "properties": { "text": "This whole page is a NavigationSplitView; each sidebar section is a separate JSON file loaded on demand by a LoadableView.", "foregroundColor": "secondary" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12 },
      "children": [
        { "type": "Image", "properties": { "systemName": "heart.fill", "imageScale": "large", "foregroundColor": "red" } },
        { "type": "Image", "properties": { "systemName": "gearshape", "imageScale": "large", "foregroundColor": "secondary" } },
        { "type": "Image", "properties": { "systemName": "trash", "imageScale": "large", "foregroundColor": "secondary" } },
        { "type": "Image", "properties": { "materialName": "rocket_launch", "imageScale": "large", "foregroundColor": "accentColor" } }
      ]
    },
    {
      "type": "HStack",
      "properties": { "spacing": 16 },
      "children": [
        { "type": "Label", "properties": { "title": "Favorites", "systemImage": "star.fill", "foregroundColor": "yellow" } },
        { "type": "Label", "properties": { "title": "Trash", "systemImage": "trash", "foregroundColor": "secondary" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Shapes (fill, stroke, bare):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12 },
      "children": [
        { "type": "Rectangle", "properties": { "fill": "blue", "frame": { "width": 56, "height": 36 } } },
        { "type": "RoundedRectangle", "properties": { "cornerRadius": 10, "fill": "teal", "frame": { "width": 56, "height": 36 } } },
        { "type": "RoundedRectangle", "properties": { "cornerRadius": 10, "cornerStyle": "continuous", "stroke": "purple", "strokeLineWidth": 2, "frame": { "width": 56, "height": 36 } } },
        { "type": "Capsule", "properties": { "fill": "accentColor", "frame": { "width": 64, "height": 24 } } },
        { "type": "Circle", "properties": { "stroke": "red", "strokeLineWidth": 3, "frame": { "width": 36, "height": 36 } } },
        { "type": "Ellipse", "properties": { "fill": "orange", "frame": { "width": 56, "height": 32 } } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Grid (explicit rows, key/value):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "Grid",
      "properties": { "alignment": "leading", "horizontalSpacing": 16, "verticalSpacing": 6 },
      "rows": [
        [
          { "type": "Text", "properties": { "text": "Name", "foregroundColor": "secondary" } },
          { "type": "Text", "properties": { "text": "ActionUIWeb" } }
        ],
        [
          { "type": "Text", "properties": { "text": "Renderer", "foregroundColor": "secondary" } },
          { "type": "Text", "properties": { "text": "DOM + CSS" } }
        ],
        [
          { "type": "Text", "properties": { "text": "Loaded from", "foregroundColor": "secondary" } },
          { "type": "Label", "properties": { "title": "overview.json", "systemImage": "doc.text" } }
        ]
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Scroll horizontally:", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "ScrollView",
      "properties": { "axis": "horizontal", "showsIndicators": false, "frame": { "maxWidth": "infinity" } },
      "content": {
        "type": "LazyHStack",
        "properties": { "spacing": 8 },
        "children": [
          { "type": "Button", "properties": { "title": "Inbox", "systemImage": "tray", "buttonStyle": "bordered" } },
          { "type": "Button", "properties": { "title": "Sent", "systemImage": "paperplane", "buttonStyle": "bordered" } },
          { "type": "Button", "properties": { "title": "Drafts", "systemImage": "doc", "buttonStyle": "bordered" } },
          { "type": "Button", "properties": { "title": "Archive", "systemImage": "archivebox", "buttonStyle": "bordered" } },
          { "type": "Button", "properties": { "title": "Flagged", "systemImage": "flag", "buttonStyle": "bordered" } },
          { "type": "Button", "properties": { "title": "Trash", "systemImage": "trash", "buttonStyle": "bordered" } }
        ]
      }
    },
    { "type": "Text", "properties": { "text": "LazyVGrid (three flexible columns):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "LazyVGrid",
      "properties": {
        "columns": [{ "flexible": true }, { "flexible": true }, { "flexible": true }],
        "spacing": 8,
        "frame": { "maxWidth": "infinity" }
      },
      "children": [
        { "type": "Button", "properties": { "title": "7", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "8", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "9", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "4", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "5", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "6", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "1", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "2", "buttonStyle": "bordered" } },
        { "type": "Button", "properties": { "title": "3", "buttonStyle": "bordered" } }
      ]
    }
  ]
}
