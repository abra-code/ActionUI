    { "type": "Text", "properties": { "text": "Element-level presentation modifiers - a 'popover' / 'sheet' / 'fullScreenCover' subview opens off the carrier's own state (a Button taps it open; the host can also setElementState):", "foregroundColor": "secondary", "font": "callout" } },
