      "properties": {
        "url": "https://abracode.com/ActionUI/Nectarine.mp4",
        "cornerRadius": 8,
        "frame": { "maxWidth": 480, "height": 240 }
      }
    },
    { "type": "Text", "properties": { "text": "A missing URL falls back to an error row:", "foregroundColor": "secondary", "font": "footnote" } },
    { "type": "VideoPlayer", "properties": {} }
  ]
}
