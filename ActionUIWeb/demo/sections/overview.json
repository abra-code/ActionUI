    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "GeometryReader (a greedy box that fills its frame and reports its measured size to the host as states[\"size\"] - read it on demand, the same call on every platform). It fills the width; its height is a fixed 90 (the bounded-axis caveat: inside a vertical scroll there is no height to fill). Resize the window, then read the size:", "foregroundColor": "secondary", "font": "callout" } },
