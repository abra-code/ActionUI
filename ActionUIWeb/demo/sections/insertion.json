{
  "type": "VStack",
  "properties": { "alignment": "leading", "spacing": 12 },
  "children": [
    { "type": "Text", "properties": { "text": "Insertion", "font": "title2" } },
    { "type": "Text", "properties": { "text": "Insertion API (add / remove views at runtime):", "foregroundStyle": "secondary", "font": "callout" } },
    { "type": "Text", "properties": { "text": "The buttons call win.insertElement / removeElement against the VStack id 200. Inserted views are live - addressable, styled, and counted - with no rebuild of the surrounding tree.", "foregroundStyle": "secondary" } },
    {
      "type": "VStack",
      "id": 200,
      "properties": { "alignment": "leading", "spacing": 6, "padding": 10, "frame": { "maxWidth": "infinity" } },
      "children": [
        { "type": "Label", "id": 201, "properties": { "title": "Seed row A", "systemImage": "circle.fill" } },
        { "type": "Label", "id": 202, "properties": { "title": "Seed row B", "systemImage": "circle.fill" } }
      ]
    },
    {
      "type": "HStack",
      "properties": { "spacing": 8 },
      "children": [
        { "type": "Button", "properties": { "title": "Append", "systemImage": "plus", "buttonStyle": "bordered", "actionID": "insAppend" } },
        { "type": "Button", "properties": { "title": "Prepend", "systemImage": "arrow.up", "buttonStyle": "bordered", "actionID": "insPrepend" } },
        { "type": "Button", "properties": { "title": "Remove last", "systemImage": "minus", "buttonStyle": "bordered", "actionID": "insRemoveLast" } }
      ]
    },
    { "type": "Text", "id": 210, "properties": { "text": "No insertions yet.", "foregroundStyle": "secondary", "font": "footnote" } },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "insertRow into a Grid (id 220; rows have no id, so whole rows append/prepend):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "Grid",
      "id": 220,
      "properties": { "alignment": "leading", "horizontalSpacing": 16, "verticalSpacing": 4 },
      "rows": [
        [
          { "type": "Text", "properties": { "text": "Name", "foregroundStyle": "secondary" } },
          { "type": "Text", "properties": { "text": "Note", "foregroundStyle": "secondary" } }
        ]
      ]
    },
    { "type": "Button", "properties": { "title": "Add Grid row", "systemImage": "plus", "buttonStyle": "bordered", "actionID": "insAddRow" } }
  ]
}
