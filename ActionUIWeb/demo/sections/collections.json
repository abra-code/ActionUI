    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "List (selectable children; a Button row keeps its own action):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "List",
      "id": 46,
      "properties": { "actionID": "listSelect", "listStyle": "inset", "frame": { "maxWidth": "infinity" } },
      "children": [
        { "type": "Label", "id": 41, "properties": { "title": "Inbox", "systemImage": "tray" } },
        { "type": "Label", "id": 42, "properties": { "title": "Drafts", "systemImage": "text.document" } },
        { "type": "Label", "id": 43, "properties": { "title": "Sent", "systemImage": "paperplane" } },
        { "type": "Button", "id": 44, "properties": { "title": "Compose", "systemImage": "square.and.pencil", "actionID": "listCompose" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "List (homogeneous itemType rows via the rows API; selectable):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "List",
      "id": 45,
      "properties": { "itemType": { "viewType": "Text" }, "actionID": "homListSelect", "frame": { "maxWidth": "infinity" } }
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "List (template repeater; $1/$2 column references, rows via the rows API):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "List",
      "id": 55,
      "properties": { "actionID": "tmplListSelect", "frame": { "maxWidth": "infinity" } },
      "template": {
        "type": "HStack",
        "children": [
          { "type": "Image", "properties": { "systemName": "$2" } },
          { "type": "Text", "properties": { "text": "$1" } }
        ]
      }
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "LazyVGrid (data-driven template mode; one substituted instance per row from the rows API, flowing into the grid):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "LazyVGrid",
      "id": 56,
      "properties": { "columns": [{ "flexible": true }, { "flexible": true }, { "flexible": true }], "spacing": 10, "frame": { "maxWidth": "infinity" } },
      "template": {
        "type": "VStack",
        "properties": { "spacing": 4, "padding": 8 },
        "children": [
          { "type": "Image", "properties": { "systemName": "$2", "imageScale": "large", "foregroundColor": "accentColor" } },
          { "type": "Text", "properties": { "text": "$1", "font": "footnote" } }
        ]
      }
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Table (rows via the rows API; an Image column and per-row Button):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "Table",
      "id": 100,
      "properties": {
        "columns": ["Name", "Kind", "Action"],
        "columnTypes": [
          { "viewType": "Text" },
          { "viewType": "Image", "dataInterpretation": "systemName" },
          { "viewType": "Button", "actionContext": "rowIndex", "actionID": "tableRowAction" }
        ],
        "widths": [150, 60, 80],
        "actionID": "tableSelect",
        "frame": { "maxWidth": "infinity" }
      }
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Insertion API (add / remove views at runtime):", "foregroundColor": "secondary", "font": "callout" } },
    { "type": "Text", "properties": { "text": "The buttons call win.insertElement / removeElement against the VStack id 200. Inserted views are live - addressable, styled, and counted - with no rebuild of the surrounding tree.", "foregroundColor": "secondary" } },
    {
      "type": "VStack",
      "id": 200,
      "properties": { "alignment": "leading", "spacing": 6, "padding": 10, "frame": { "maxWidth": "infinity" } },
      "children": [
        { "type": "Label", "id": 201, "properties": { "title": "Seed row A", "systemImage": "circle.fill" } },
        { "type": "Label", "id": 202, "properties": { "title": "Seed row B", "systemImage": "circle.fill" } }
      ]
    },
    {
      "type": "HStack",
      "properties": { "spacing": 8 },
      "children": [
        { "type": "Button", "properties": { "title": "Append", "systemImage": "plus", "buttonStyle": "bordered", "actionID": "insAppend" } },
        { "type": "Button", "properties": { "title": "Prepend", "systemImage": "arrow.up", "buttonStyle": "bordered", "actionID": "insPrepend" } },
        { "type": "Button", "properties": { "title": "Remove last", "systemImage": "minus", "buttonStyle": "bordered", "actionID": "insRemoveLast" } }
      ]
    },
    { "type": "Text", "id": 210, "properties": { "text": "No insertions yet.", "foregroundColor": "secondary", "font": "footnote" } },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "insertRow into a Grid (id 220; rows have no id, so whole rows append/prepend):", "foregroundColor": "secondary", "font": "callout" } },
    {
      "type": "Grid",
      "id": 220,
      "properties": { "alignment": "leading", "horizontalSpacing": 16, "verticalSpacing": 4 },
      "rows": [
        [
          { "type": "Text", "properties": { "text": "Name", "foregroundColor": "secondary" } },
          { "type": "Text", "properties": { "text": "Note", "foregroundColor": "secondary" } }
        ]
      ]
    },
    { "type": "Button", "properties": { "title": "Add Grid row", "systemImage": "plus", "buttonStyle": "bordered", "actionID": "insAddRow" } }
  ]
}
