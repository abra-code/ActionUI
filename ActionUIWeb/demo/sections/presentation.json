{
  "type": "VStack",
  "properties": { "alignment": "leading", "spacing": 12 },
  "children": [
    { "type": "Text", "properties": { "text": "Presentation", "font": "title2" } },
    { "type": "Text", "properties": { "text": "Element-level presentation modifiers - a 'popover' / 'sheet' / 'fullScreenCover' subview opens off the carrier's own state (a Button taps it open; the host can also setElementState):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12, "alignment": "center" },
      "children": [
        {
          "type": "Button",
          "id": 300,
          "properties": { "title": "Popover", "systemImage": "info.circle", "buttonStyle": "bordered", "popoverActionID": "demoPopoverShown" },
          "popover": {
            "type": "VStack",
            "properties": { "alignment": "leading", "spacing": 8, "padding": "default", "frame": { "width": 240 } },
            "children": [
              { "type": "Text", "properties": { "text": "Popover content", "font": "headline" } },
              { "type": "Text", "properties": { "text": "A top-layer panel anchored to the button. Click outside or press Escape to dismiss.", "font": "footnote", "foregroundStyle": "secondary" } },
              { "type": "Toggle", "id": 305, "properties": { "title": "A live control", "isOn": true } }
            ]
          }
        },
        {
          "type": "Text",
          "id": 306,
          "properties": { "text": "Text with a popover (tap me)", "foregroundStyle": "accentColor", "popoverArrowEdge": "bottom" },
          "popover": {
            "type": "Text",
            "properties": { "text": "Any view can carry a popover.", "padding": "default" }
          }
        }
      ]
    },
    {
      "type": "HStack",
      "properties": { "spacing": 12, "alignment": "center" },
      "children": [
        {
          "type": "Button",
          "id": 301,
          "properties": { "title": "Show Sheet", "systemImage": "rectangle.portrait", "buttonStyle": "borderedProminent", "sheetOnDismissActionID": "demoSheetDismissed" },
          "sheet": {
            "type": "VStack",
            "properties": { "alignment": "leading", "spacing": 14, "padding": "default", "frame": { "width": 360 } },
            "children": [
              { "type": "Text", "properties": { "text": "Sheet", "font": "title2" } },
              { "type": "Text", "properties": { "text": "A native <dialog> shown with showModal(). Dismiss with Escape, the backdrop, or the button below (which calls setElementState sheetVisible=false).", "foregroundStyle": "secondary" } },
              { "type": "Toggle", "id": 307, "properties": { "title": "A live control inside the sheet", "isOn": false } },
              { "type": "Button", "properties": { "title": "Done", "buttonStyle": "borderedProminent", "actionID": "demoSheetClose" } }
            ]
          }
        },
        {
          "type": "Button",
          "id": 302,
          "properties": { "title": "Full Screen Cover", "systemImage": "arrow.up.left.and.arrow.down.right", "buttonStyle": "bordered", "fullScreenCoverOnDismissActionID": "demoCoverDismissed" },
          "fullScreenCover": {
            "type": "VStack",
            "properties": { "alignment": "center", "spacing": 16, "padding": "default", "frame": { "maxWidth": "infinity", "maxHeight": "infinity" } },
            "children": [
              { "type": "Text", "properties": { "text": "Full Screen Cover", "font": "largeTitle" } },
              { "type": "Text", "properties": { "text": "Fills the viewport. No OS cover on a desktop target - Escape or the button dismisses.", "foregroundStyle": "secondary" } },
              { "type": "Button", "properties": { "title": "Close", "systemImage": "xmark", "buttonStyle": "borderedProminent", "actionID": "demoCoverClose" } }
            ]
          }
        }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Window-level dialogs (a native top-layer <dialog>):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 8 },
      "children": [
        { "type": "Button", "properties": { "title": "Show Alert", "systemImage": "exclamationmark.bubble", "buttonStyle": "bordered", "actionID": "showAlert" } },
        { "type": "Button", "properties": { "title": "Confirm Delete", "systemImage": "trash", "buttonStyle": "bordered", "actionID": "showConfirm" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Window-level modals (presentModal loads a JSON sub-document into a native <dialog>; the modal's Close button routes an actionID to dismissModal):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 8 },
      "children": [
        { "type": "Button", "properties": { "title": "Sheet Modal", "systemImage": "tray", "buttonStyle": "bordered", "actionID": "showSheetModal" } },
        { "type": "Button", "properties": { "title": "Cover Modal", "systemImage": "rectangle.portrait", "buttonStyle": "bordered", "actionID": "showCoverModal" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Window-level toast (a transient non-modal snackbar; rapid posts queue and show one at a time):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 8 },
      "children": [
        { "type": "Button", "properties": { "title": "Show Toast", "systemImage": "bell", "buttonStyle": "bordered", "actionID": "showToast" } },
        { "type": "Button", "properties": { "title": "Toast with Undo", "systemImage": "arrow.uturn.backward", "buttonStyle": "bordered", "actionID": "showToastUndo" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "contextMenu (any view): right-click on a desktop, or long-press on touch, to open an action menu. contextMenu / contextMenuPreview are TOP-LEVEL subview keys holding real elements (Buttons for actions; an arbitrary preview view), modeled after SwiftUI's .contextMenu(menuItems:preview:). Below, a small image thumbnail enlarges in the preview; each Button fires its actionID (echoed above).", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "Image",
      "id": 320,
      "properties": {
        "resourceName": "abracadabra.png",
        "contentMode": "fit",
        "frame": { "width": 72, "height": 72 },
        "cornerRadius": 8
      },
      "contextMenu": [
        { "type": "Button", "properties": { "title": "Rename", "systemImage": "pencil", "actionID": "ctxRename" } },
        { "type": "Button", "properties": { "title": "Share", "systemImage": "square.and.arrow.up", "actionID": "ctxShare" } },
        { "type": "Divider" },
        { "type": "Button", "properties": { "title": "Delete", "systemImage": "trash", "role": "destructive", "actionID": "ctxDelete" } }
      ],
      "contextMenuPreview": {
        "type": "Image",
        "properties": {
          "resourceName": "abracadabra.png",
          "contentMode": "fit",
          "frame": { "width": 240, "height": 240 }
        }
      }
    },
    { "type": "Text", "properties": { "text": "...and the preview is an arbitrary view, so it can be an HStack of items side by side (which a menu list can't lay out):", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "Text",
      "id": 321,
      "properties": {
        "text": "Right-click / long-press for a rich preview",
        "padding": "default",
        "background": "gray.opacity(0.15)",
        "cornerRadius": 8
      },
      "contextMenu": [
        { "type": "Button", "properties": { "title": "Pin", "systemImage": "pin", "actionID": "ctxPin" } }
      ],
      "contextMenuPreview": {
        "type": "HStack",
        "properties": { "spacing": 16, "padding": "default" },
        "children": [
          { "type": "Image", "properties": { "systemName": "star.fill", "foregroundStyle": "yellow", "imageScale": "large" } },
          { "type": "Image", "properties": { "systemName": "heart.fill", "foregroundStyle": "pink", "imageScale": "large" } },
          { "type": "Image", "properties": { "systemName": "bolt.fill", "foregroundStyle": "orange", "imageScale": "large" } }
        ]
      }
    }
  ]
}
