{
  "type": "VStack",
  "properties": { "alignment": "leading", "spacing": 12 },
  "children": [
    { "type": "Text", "properties": { "text": "Symbols", "font": "title2" } },
    { "type": "Text", "properties": { "text": "Icon glyphs are Image with a systemName (an SF Symbol) or an explicit materialName. ActionUI maps each SF Symbol to the closest Material Symbol; a name with no mapping renders nothing and logs a warning in the Diagnostics panel below. Turn on 'Debug glyphs' (then reload) to draw a broken-image placeholder in its place.", "foregroundStyle": "secondary" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12 },
      "children": [
        { "type": "Image", "properties": { "systemName": "heart.fill", "imageScale": "large", "foregroundStyle": "red" } },
        { "type": "Image", "properties": { "systemName": "gearshape", "imageScale": "large", "foregroundStyle": "secondary" } },
        { "type": "Image", "properties": { "systemName": "trash", "imageScale": "large", "foregroundStyle": "secondary" } },
        { "type": "Image", "properties": { "materialName": "rocket_launch", "imageScale": "large", "foregroundStyle": "accentColor" } }
      ]
    },
    {
      "type": "HStack",
      "properties": { "spacing": 16 },
      "children": [
        { "type": "Label", "properties": { "title": "Favorites", "systemImage": "star.fill", "foregroundStyle": "yellow" } },
        { "type": "Label", "properties": { "title": "Trash", "systemImage": "trash", "foregroundStyle": "secondary" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Fluent System Icons fill in the SF Symbols Material has no glyph for (after scripts/make-symbol-fonts.sh). Odd positions: Material; even positions: Fluent.", "foregroundStyle": "secondary", "font": "callout" } },
    {
      "type": "HStack",
      "properties": { "spacing": 10 },
