        { "type": "Image", "properties": { "systemName": "bell", "imageScale": "large" } },
        { "type": "Image", "properties": { "systemName": "ring.dashed", "imageScale": "large" } },
        { "type": "Image", "properties": { "systemName": "trash", "imageScale": "large" } },
        { "type": "Image", "properties": { "systemName": "square.dotted", "imageScale": "large" } }
      ]
    },
    {
      "type": "HStack",
      "properties": { "spacing": 10 },
      "children": [
        { "type": "Image", "properties": { "systemName": "house.fill", "imageScale": "large" } },
        { "type": "Image", "properties": { "systemName": "key.card.fill", "imageScale": "large" } },
        { "type": "Image", "properties": { "systemName": "folder.fill", "imageScale": "large" } },
