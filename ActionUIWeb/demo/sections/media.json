      "properties": {
        "html": "<style>body{font:15px -apple-system,system-ui,sans-serif;margin:16px;color:#1d1d1f}h1{margin:0 0 8px}a{color:#007aff}</style><h1>Hello from a WebView</h1><p>This page is inline <code>html</code> rendered through an iframe srcdoc. The same JSON drives a WKWebView on Apple and an android.webkit.WebView on Android.</p><p><a href=\"https://www.swift.org\" target=\"_blank\">An external link</a></p>",
