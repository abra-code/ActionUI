; ActionUIWinUI/Library/ActionUI.def
; The C functions ActionUI.dll exports: every function ActionUICAdapter/include/ActionUIC.h and
; ActionUIAppKitApplication/include/ActionUIApp.h declare for Windows, in the headers' order. SwiftPM exports
; from a Windows DLL only the modules its product lists, and these functions are in ActionUI's package, so the
; linker takes their names from here (Package.swift). Scripts/ci-windows.py checks this list against the headers.
; A new C function is a line here.
EXPORTS
    actionUIGetVersion
    actionUIGetLastError
    actionUIClearError
    actionUIFreeString
    actionUISetLogger
    actionUILog
    actionUIRegisterActionHandler
    actionUIUnregisterActionHandler
    actionUISetDefaultActionHandler
    actionUIRemoveDefaultActionHandler
    actionUISetElementValueJSON
    actionUIGetElementValueJSON
    actionUISetElementValueString
    actionUIGetElementValueString
    actionUIAppendElementText
    actionUISetIntValue
    actionUIGetIntValue
    actionUISetDoubleValue
    actionUIGetDoubleValue
    actionUISetBoolValue
    actionUIGetBoolValue
    actionUISetStringValue
    actionUIGetStringValue
    actionUISetElementPropertyJSON
    actionUIGetElementPropertyJSON
    actionUISetElementStateJSON
    actionUIGetElementStateJSON
    actionUISetElementStateFromString
    actionUIGetElementStateString
    actionUIGetElementInfoJSON
    actionUIRemoveWindow
    actionUIGetContentSizeLimits
    actionUISetElementRowsJSON
    actionUIAppendElementRowsJSON
    actionUIGetElementRowsJSON
    actionUIClearElementRows
    actionUIGetElementColumnCount
    actionUISelectElementRowByIndex
    actionUISelectElementRowWithContent
    actionUIClearElementSelection
    actionUIInsertElement
    actionUIInsertRow
    actionUIRemoveElement
    actionUIPresentModal
