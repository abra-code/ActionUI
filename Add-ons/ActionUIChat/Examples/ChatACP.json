{
  "type": "VStack",
  "properties": { "spacing": 8, "padding": 12 },
  "children": [
    { "type": "Text", "properties": { "text": "Chat over ACP: the host launches the agent (here OpenCode) and injects its protocol/transport into the element's states[\"config\"] at runtime - thoughts, tool calls, and permission approvals included.", "font": "headline" } },
    {
      "type": "Chat",
      "id": 84,
      "properties": {
        "appearance": { "alignment": "single", "showRoleLabels": true },
        "roles": {
          "local": { "label": "You", "tint": "accent" },
          "agent": { "label": "Agent", "tint": "secondary" }
        },
        "input": { "enabled": true, "placeholder": "Ask the agent", "submitOn": "modifier-return" },
        "surfaces": { "toolCalls": "inline", "thoughts": "collapsed" },
        "sendActionID": "chat.send",
        "stopActionID": "chat.stop",
        "messageActionID": "chat.message",
        "errorActionID": "chat.error",
        "approveToolActionID": "chat.tool.approve",
        "frame": { "maxWidth": "infinity", "maxHeight": "infinity" }
      }
    }
  ]
}
