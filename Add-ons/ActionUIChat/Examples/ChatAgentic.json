{
  "type": "VStack",
  "properties": { "spacing": 8, "padding": 12 },
  "children": [
    { "type": "Text", "properties": { "text": "Chat (agentic demo): the scripted turn streams thoughts, runs tool calls, and asks for permission before editing.", "font": "headline" } },
    {
      "type": "Chat",
      "id": 81,
      "properties": {
        "protocol": "local",
        "appearance": { "alignment": "single", "showRoleLabels": true },
        "roles": {
          "local": { "label": "You", "tint": "accent" },
          "agent": { "label": "Agent", "tint": "secondary" }
        },
        "input": { "enabled": true, "placeholder": "Ask the agent to change something", "submitOn": "modifier-return" },
        "surfaces": { "toolCalls": "inline", "thoughts": "collapsed" },
        "transport": { "reply": "agentic" },
        "sendActionID": "chat.send",
        "messageActionID": "chat.message",
        "approveToolActionID": "chat.tool.approve",
        "frame": { "maxWidth": "infinity", "maxHeight": "infinity" }
      }
    }
  ]
}
