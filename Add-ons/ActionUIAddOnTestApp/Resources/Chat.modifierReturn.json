{
  "type": "VStack",
  "properties": { "spacing": 8, "padding": 12 },
  "children": [
    { "type": "Text", "properties": { "text": "Chat - multiline composer (Return inserts a newline; Cmd+Return sends):", "font": "headline" } },
    {
      "type": "Chat",
      "id": 81,
      "config": {
        "protocol": "local",
        "transport": { "echo": true }
      },
      "properties": {
        "appearance": { "alignment": "single", "showRoleLabels": true },
        "roles": {
          "local": { "label": "You",  "tint": "blue" },
          "agent": { "label": "Echo", "tint": "green" }
        },
        "input": { "enabled": true, "placeholder": "Write a few lines, then Cmd+Return", "submitOn": "modifier-return" },
        "sendActionID": "chat.send",
        "messageActionID": "chat.message",
        "frame": { "maxWidth": "infinity", "maxHeight": "infinity" }
      }
    }
  ]
}
