<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Self-registration at process start (see RichTextProvider). The ${applicationId}
             placeholder keeps the authority unique per installing app, as the system requires. -->
        <provider
            android:name="com.abracode.actionui.addon.richtext.RichTextProvider"
            android:authorities="${applicationId}.actionui-addon-richtext"
            android:exported="false" />
    </application>
</manifest>
