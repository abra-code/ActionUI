local.properties

# Material Symbols (Rounded) variable font (~15 MB) - downloaded into library
# assets by the fetchMaterialSymbols Gradle task (runs on preBuild), so not
# committed. See library/build.gradle.kts.
/library/src/main/assets/fonts/MaterialSymbolsRounded.ttf

# Material name->codepoint table - also downloaded by fetchMaterialSymbols, into
# assets/symbols/ next to the SF->Material map (both are lookup tables).
/library/src/main/assets/symbols/MaterialSymbolsRounded.codepoints

# SF Symbols -> Material Symbols embedded map (compiled by
# Tools/material_symbols/build_sf_material_map.py from the glyphsvg mapping).
# Ignored while the mapping is in development and the systemName path is unwired.
# When the mapping is finalized: regenerate, remove this line, and COMMIT the map
# (unlike the font it is not publicly downloadable, so the library needs it tracked).
/library/src/main/assets/symbols/sf_to_material.map
