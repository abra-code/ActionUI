      { "type": "Divider" },

      {
        "type": "Text",
        "properties": { "text": "openURLActionID - deep-link round trip", "font": "headline" }
      },
      {
        "type": "Text",
        "properties": {
          "text": "The Link opens actionui://hooks/hello through the system; the demo app's intent filter routes it back, the Activity forwards it to ActionUIModel.onOpenURL, and the badge below receives it.",
          "font": "caption",
          "foregroundStyle": "secondary"
        }
      },
      {
        "type": "Link",
        "properties": {
