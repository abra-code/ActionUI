{
  "type": "VStack",
  "properties": {
    "padding": 20.0,
    "spacing": 16.0,
    "alignment": "leading"
  },
  "children": [
      {
        "type": "Text",
        "properties": {
          "text": "animation Modifier Demo",
          "font": "title2",
          "padding": { "bottom": 4.0 }
        }
      },
      {
        "type": "Text",
        "properties": {
          "text": "Tap the buttons to mutate properties through setElementProperty. Each element animates the change using its configured curve.",
          "font": "caption",
          "foregroundStyle": "secondary",
          "padding": { "bottom": 8.0 }
        }
      },

      {
        "type": "Text",
        "properties": { "text": "\"spring\" shorthand - any mutation", "font": "headline" }
      },
      {
        "type": "HStack",
        "properties": { "spacing": 16.0 },
        "children": [
          {
            "type": "Circle",
            "id": 101,
            "properties": {
              "fill": "blue",
              "frame": { "width": 70.0, "height": 70.0 },
              "opacity": 1.0,
              "scaleEffect": 1.0,
              "animation": "spring"
            }
          },
          {
            "type": "VStack",
            "properties": { "spacing": 8.0, "alignment": "leading" },
            "children": [
              {
                "type": "Button",
                "properties": {
                  "title": "Fade opacity",
                  "buttonStyle": "bordered",
                  "actionID": "anim.demo.101.opacity"
                }
              },
              {
                "type": "Button",
                "properties": {
                  "title": "Scale",
                  "buttonStyle": "bordered",
                  "actionID": "anim.demo.101.scale"
                }
              }
            ]
          }
        ]
      },

      { "type": "Divider" },

      {
        "type": "Text",
        "properties": { "text": "\"easeInOut\", duration 0.5, watching \"opacity\"", "font": "headline" }
      },
      {
        "type": "Text",
        "properties": {
          "text": "Scale button mutates scaleEffect - not watched, so it snaps.",
          "font": "caption",
          "foregroundStyle": "secondary"
        }
      },
      {
        "type": "HStack",
        "properties": { "spacing": 16.0 },
        "children": [
          {
            "type": "Rectangle",
            "id": 102,
            "properties": {
              "fill": "orange",
              "frame": { "width": 70.0, "height": 70.0 },
              "cornerRadius": 8.0,
              "opacity": 1.0,
              "scaleEffect": 1.0,
              "animation": {
                "curve": "easeInOut",
                "duration": 0.5,
                "value": "opacity"
              }
            }
          },
          {
            "type": "VStack",
            "properties": { "spacing": 8.0, "alignment": "leading" },
            "children": [
              {
                "type": "Button",
                "properties": {
                  "title": "Fade opacity (animated)",
                  "buttonStyle": "bordered",
                  "actionID": "anim.demo.102.opacity"
                }
              },
              {
                "type": "Button",
                "properties": {
                  "title": "Scale (snaps)",
                  "buttonStyle": "bordered",
                  "actionID": "anim.demo.102.scale"
                }
              }
            ]
          }
        ]
      },

      { "type": "Divider" },

      {
        "type": "Text",
        "properties": { "text": "\"bouncy\", watching \"scaleEffect\"", "font": "headline" }
      },
      {
        "type": "HStack",
        "properties": { "spacing": 16.0 },
        "children": [
          {
            "type": "RoundedRectangle",
            "id": 103,
            "properties": {
              "cornerRadius": 12.0,
              "fill": "green",
              "frame": { "width": 70.0, "height": 70.0 },
              "scaleEffect": 1.0,
              "animation": {
                "curve": "bouncy",
                "value": "scaleEffect"
              }
            }
          },
          {
            "type": "Button",
            "properties": {
              "title": "Bounce scale",
              "buttonStyle": "bordered",
              "actionID": "anim.demo.103.scale"
            }
          }
        ]
      },

      { "type": "Divider" },

      {
        "type": "Text",
        "properties": { "text": "\"snappy\", delay 0.15, watching \"background\"", "font": "headline" }
      },
      {
        "type": "HStack",
        "properties": { "spacing": 16.0 },
        "children": [
          {
            "type": "Text",
            "id": 104,
            "properties": {
              "text": "Badge",
              "foregroundStyle": "white",
              "padding": 16.0,
              "background": "purple",
              "cornerRadius": 12.0,
              "animation": {
                "curve": "snappy",
                "delay": 0.15,
                "value": "background"
              }
            }
          },
          {
            "type": "Button",
            "properties": {
              "title": "Change color",
              "buttonStyle": "bordered",
              "actionID": "anim.demo.104.color"
            }
          }
        ]
      },

      { "type": "Divider" },

      {
        "type": "Text",
        "properties": { "text": "\"linear\", duration 0.8, watching \"rotationEffect\"", "font": "headline" }
      },
      {
        "type": "HStack",
        "properties": { "spacing": 16.0 },
        "children": [
          {
            "type": "Rectangle",
            "id": 105,
            "properties": {
              "fill": "red",
              "frame": { "width": 60.0, "height": 60.0 },
              "cornerRadius": 4.0,
              "rotationEffect": 0.0,
              "animation": {
                "curve": "linear",
                "duration": 0.8,
                "value": "rotationEffect"
              }
            }
          },
          {
            "type": "Button",
            "properties": {
              "title": "Rotate 90",
              "buttonStyle": "bordered",
              "actionID": "anim.demo.105.rotate"
            }
          }
        ]
      },

      { "type": "Divider" },

      {
        "type": "Text",
        "properties": { "text": "\"smooth\", watching \"offset\"", "font": "headline" }
      },
      {
        "type": "VStack",
        "properties": { "spacing": 8.0, "alignment": "leading" },
        "children": [
          {
            "type": "Circle",
            "id": 106,
            "properties": {
              "fill": "teal",
              "frame": { "width": 50.0, "height": 50.0 },
              "offset": { "x": 0.0, "y": 0.0 },
              "animation": {
                "curve": "smooth",
                "value": "offset"
              }
            }
          },
          {
            "type": "Button",
            "properties": {
              "title": "Slide",
              "buttonStyle": "bordered",
              "actionID": "anim.demo.106.offset"
            }
          }
        ]
      },

      { "type": "Divider" },

      {
        "type": "Text",
        "properties": { "text": "\"spring\", watching \"frame\"", "font": "headline" }
      },
      {
        "type": "HStack",
        "properties": { "spacing": 16.0 },
        "children": [
          {
            "type": "Rectangle",
            "id": 107,
            "properties": {
              "fill": "indigo",
              "frame": { "width": 70.0, "height": 70.0 },
              "cornerRadius": 8.0,
              "animation": {
                "curve": "spring",
                "value": "frame"
              }
            }
          },
          {
            "type": "Button",
            "properties": {
              "title": "Grow width",
              "buttonStyle": "bordered",
              "actionID": "anim.demo.107.width"
            }
          }
        ]
      }
  ]
}
