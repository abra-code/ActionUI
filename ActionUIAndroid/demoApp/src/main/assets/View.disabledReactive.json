    { "type": "Text", "properties": { "text": "Ancestor narrowing (SwiftUI parity)", "font": "headline" } },
    { "type": "Text", "properties": { "text": "The child is authored disabled:false but the container is disabled - it must stay disabled until the container re-enables.", "foregroundStyle": "secondary" } },
