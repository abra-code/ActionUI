      { "type": "NavigationLink", "id": 3, "properties": { "title": "inlineLarge -> MediumTopAppBar", "destinationViewId": 10 } },
      { "type": "NavigationLink", "id": 4, "properties": { "title": "inline -> small TopAppBar", "destinationViewId": 11 } },
      { "type": "NavigationLink", "id": 5, "properties": { "title": "automatic -> small TopAppBar", "destinationViewId": 12 } }
    ]
  },
  "destinations": [
    {
      "type": "VStack",
      "id": 10,
      "properties": { "spacing": 8, "padding": 16, "navigationTitle": "Medium Title", "toolbarTitleDisplayMode": "inlineLarge" },
