{
  "type": "VStack",
  "properties": { "spacing": 16, "padding": 16, "alignment": "leading" },
  "children": [
    { "type": "Text", "properties": { "text": "Menu style (default), with a section header + divider; tinted purple (focused accent + selected row):" } },
    {
      "type": "Picker",
      "id": 1,
      "properties": {
        "title": "Language",
        "options": [
          { "section": "Popular" },
          { "title": "Kotlin", "tag": "kt" },
          { "title": "Swift", "tag": "sw" },
          { "divider": true },
          { "title": "Other", "tag": "other" }
        ],
        "actionID": "picker.changed",
        "tint": "purple",
        "frame": { "width": "infinity" }
      }
    },
    { "type": "Text", "properties": { "text": "Segmented style (simple array, auto-tagged 1..n); tint fills the selected segment:" } },
    {
      "type": "Picker",
      "id": 2,
      "properties": {
        "options": ["Day", "Week", "Month"],
        "pickerStyle": "segmented",
        "actionID": "picker.changed",
        "tint": "purple"
      }
    },
    { "type": "Text", "properties": { "text": "Radio group style; tint colors the selected dot:" } },
    {
      "type": "Picker",
      "id": 3,
      "properties": {
        "title": "Size",
        "options": [
          { "title": "Small", "tag": "s" },
          { "title": "Medium", "tag": "m" },
          { "title": "Large", "tag": "l" }
        ],
        "pickerStyle": "radioGroup",
        "actionID": "picker.changed",
        "tint": "purple"
      }
    },
    {
      "type": "Button",
      "id": 4,
      "properties": { "title": "Read Language selection", "actionID": "picker.read" }
    }
  ]
}
