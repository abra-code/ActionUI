{
  "type": "VStack",
  "properties": { "spacing": 12, "padding": 16, "alignment": "leading" },
  "children": [
    { "type": "Text", "properties": { "text": "Hello from ActionUI on Android" } },
    {
      "type": "Text",
      "properties": {
        "text": "(default — should be overridden)",
        "text:android": "(running on Android)",
        "text:ios": "(running on iOS — should NOT appear here)",
        "text:apple": "(running on an Apple platform — should NOT appear here)"
      }
    },
    {
      "type": "Text",
      "properties": {
        "text": "Padded with rounded gray background",
        "padding": 12,
        "background": "lightgray",
        "cornerRadius": 8
      }
    },
    {
      "type": "Text",
      "properties": {
        "text": "50% opacity",
        "opacity": 0.5
      }
    },
    {
      "type": "Text",
      "properties": {
        "text": "Fixed width 200dp, hex background",
        "frame": { "width": 200 },
        "background": "#FFE0B2",
        "padding": 8,
        "cornerRadius": 4
      }
    },
    {
      "type": "HStack",
      "properties": { "spacing": 8 },
      "children": [
        {
          "type": "Text",
          "properties": {
            "text": "1/3",
            "weight:android": 1,
            "background": "#FFCDD2",
            "padding": 8,
            "cornerRadius": 4
          }
        },
        {
          "type": "Text",
          "properties": {
            "text": "2/3 (wider)",
            "weight:android": 2,
            "background": "#C8E6C9",
            "padding": 8,
            "cornerRadius": 4
          }
        }
      ]
    },
    {
      "type": "HStack",
      "properties": {
        "spacing": 12,
        "padding": 8,
        "frame": { "height": 80 },
        "alignment": "bottom",
        "background": "#E3F2FD",
        "cornerRadius": 6
      },
      "children": [
        { "type": "Text", "properties": { "text": "all" } },
        { "type": "Text", "properties": { "text": "aligned" } },
        { "type": "Text", "properties": { "text": "bottom" } }
      ]
    },
    {
      "type": "HStack",
      "properties": {
        "spacing": 12,
        "padding": 8,
        "frame": { "height": 60 },
        "alignment": "firstTextBaseline",
        "background": "#FFF3E0",
        "cornerRadius": 6
      },
      "children": [
        { "type": "Text", "properties": { "text": "SwiftUI 'firstTextBaseline'" } },
        { "type": "Text", "properties": { "text": "no Compose equiv. - default used (logged)" } }
      ]
    },
    {
      "type:android": "HStack",
      "type:ios": "VStack",
      "properties": { "spacing": 12 },
      "children": [
        { "type": "Text", "properties": { "text": "Left" } },
        { "type": "Text", "properties": { "text": "|" } },
        { "type": "Text", "properties": { "text": "Right" } }
      ]
    },
    { "type": "Divider" },
    {
      "type": "HStack",
      "properties": { "spacing": 8 },
      "children": [
        { "type": "Text", "properties": { "text": "Left" } },
        { "type": "Spacer" },
        { "type": "Text", "properties": { "text": "Right (pushed by Spacer)" } }
      ]
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Image from assets/ (resourceName), fit:" } },
    {
      "type": "Image",
      "properties": {
        "resourceName": "sample_image.png",
        "contentMode": "fit",
        "frame": { "height": 100 },
        "accessibilityLabel": "Sample gradient image"
      }
    },
    { "type": "Text", "properties": { "text": "Same image, fill + rounded corners:" } },
    {
      "type": "Image",
      "properties": {
        "resourceName": "sample_image.png",
        "contentMode": "fill",
        "frame": { "width": 200, "height": 60 },
        "cornerRadius": 8
      }
    },
    {
      "type": "Text",
      "properties": { "text": "Cross-platform source: SF Symbol on iOS, assets/ image on Android:" }
    },
    {
      "type": "Image",
      "properties": {
        "systemName": "star.fill",
        "resourceName": "sample_image.png",
        "contentMode": "fit",
        "frame": { "height": 60 }
      }
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Shapes (fill / stroke):" } },
    {
      "type": "HStack",
      "properties": { "spacing": 12 },
      "children": [
        {
          "type": "Rectangle",
          "properties": { "fill": "#FFCDD2", "frame": { "width": 60, "height": 60 } }
        },
        {
          "type": "RoundedRectangle",
          "properties": {
            "cornerRadius": 12,
            "fill": "#90CAF9",
            "frame": { "width": 60, "height": 60 }
          }
        },
        {
          "type": "Circle",
          "properties": { "fill": "#A5D6A7", "frame": { "width": 60, "height": 60 } }
        },
        {
          "type": "Ellipse",
          "properties": {
            "stroke": "purple",
            "strokeLineWidth": 3,
            "frame": { "width": 90, "height": 60 }
          }
        }
      ]
    },
    {
      "type": "Capsule",
      "properties": { "fill": "orange", "frame": { "width": 160, "height": 32 } }
    },
    { "type": "Divider" },
    { "type": "Text", "properties": { "text": "Progress (determinate then indeterminate):" } },
    {
      "type": "ProgressView",
      "properties": { "value": 0.7, "total": 1.0, "title": "Downloading…", "frame": { "width": 220 } }
    },
    { "type": "ProgressView" },
    {
      "type": "Button",
      "id": 1,
      "properties": { "title": "Tap me", "actionID": "button.tap" }
    },
    {
      "type": "Button",
      "id": 2,
      "properties": { "title": "Delete", "role": "destructive", "actionID": "button.delete" }
    },
    {
      "type:ios": "Text",
      "properties": { "text": "iOS-only element (should NOT render on Android)" }
    }
  ]
}
