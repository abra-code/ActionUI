{
  "type": "VStack",
  "properties": {
    "spacing": 16,
    "alignment": "leading",
    "padding": "default"
  },
  "children": [
    {
      "type": "Text",
      "properties": { "text": "textSelection", "font": "title" }
    },
    {
      "type": "Text",
      "properties": {
        "text": "Long-press selectable text; 'disabled' opts a subtree back out.",
        "font": "caption",
        "foregroundStyle": "secondary"
      }
    },

    { "type": "Divider", "properties": {} },

    {
      "type": "Text",
      "properties": {
        "text": "Selectable text - long-press to select",
        "font": "body",
        "textSelection": "enabled"
      }
    },
    {
      "type": "Text",
      "properties": {
        "text": "Plain text - not selectable (the default)"
      }
    },

    { "type": "Divider", "properties": {} },

    {
      "type": "VStack",
      "properties": {
        "spacing": 4,
        "padding": 8,
        "background": "lightgray",
        "cornerRadius": 8,
        "textSelection": "enabled"
      },
      "children": [
        {
          "type": "Text",
          "properties": { "text": "All text in this container is selectable" }
        },
        {
          "type": "Text",
          "properties": { "text": "because textSelection propagates to child Text views" }
        },
        {
          "type": "Text",
          "properties": {
            "text": "...except this line, which opts back out with 'disabled'",
            "textSelection": "disabled"
          }
        }
      ]
    }
  ]
