<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Self-registration at process start (see OsmMapProvider). The
             ${applicationId} placeholder keeps the authority unique per
             installing app, as the system requires. -->
        <provider
            android:name="com.abracode.actionui.map.osm.OsmMapProvider"
            android:authorities="${applicationId}.actionui-map-osm"
            android:exported="false" />
    </application>

</manifest>
