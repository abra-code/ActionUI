    { "type": "Toggle", "id": 92, "properties": { "title": "Hidden", "isOn": false, "actionID": "hostSurface.hidden" } },
    { "type": "Toggle", "id": 93, "properties": { "title": "Padding", "isOn": false, "actionID": "hostSurface.padding" } },
    { "type": "Text", "id": 94, "properties": { "text": "Drag in the area to draw. Surface events appear in logcat (tag HostSurfaceDemo).", "foregroundStyle": "secondary" } }
